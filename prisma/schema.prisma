// 핫딜마켓 발주 플랫폼 — Prisma schema
// roles/categories/status 는 문자열 + 앱 레벨 상수(src/lib/constants.ts)로 관리.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel-Neon 통합이 만든 변수명 사용(앱 런타임/빌드가 직접 읽음).
  // 로컬은 .env 에서 같은 이름으로 로컬 Postgres 를 가리킴.
  url       = env("hotdealorder_POSTGRES_PRISMA_URL") // pooled (앱)
  directUrl = env("hotdealorder_DATABASE_URL_UNPOOLED") // direct (마이그레이션)
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // 아이디
  passwordHash String
  // role: APPLICANT | MERCHANT_HOTDEAL | MERCHANT_SEOBU | VENDOR_SEOBU | VENDOR_JANGHEUNG | VENDOR_CHAEUMCHAE | ADMIN_SAEROP
  role         String   @default("APPLICANT")
  // status: PENDING | APPROVED | REJECTED
  status       String   @default("PENDING")

  storeName    String // 상호명
  phone        String // 연락처
  address      String // 업장 소재지
  businessCert String? // 사업자등록증 파일 경로/URL

  // 입금 자동매칭용 — 이 점포가 입금 시 통장에 찍히는 예금주/입금자명(가입 시 입력, 여러 개)
  payerNames   String[] @default([])
  // 미수 잠금 1회성 해제(관리자가 임의 출고 시) — 미납 계산서가 있어도 발주 허용
  orderUnlock  Boolean  @default(false)
  // 해제한 시각 — 그 '발주창'에만 유효(1회성). 다음 창엔 미수가 남아있으면 다시 잠긴다.
  orderUnlockAt DateTime?

  // 주간발주 미수 잠금 1회성 해제(일일 발주 잠금과 독립) — 주간 미납이 있어도 이번 주간발주 허용
  weeklyOrderUnlock   Boolean   @default(false)
  weeklyOrderUnlockAt DateTime?

  // 가맹 오픈 온보딩(퀘스트). startedAt 있으면 온보딩 대상 → 100%까지 발주 잠금.
  // completedAt 있으면 발주 오픈. 기존 점주는 startedAt=null이라 게이트 무관(영향 없음).
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?

  orders          Order[]
  weeklyOrders    WeeklyOrder[]
  reservationOrders ReservationOrder[]
  stockHolds      StockHold[]
  pushSubs        PushSubscription[]
  matchedDeposits Deposit[]
  invoices        Invoice[]
  receivableAdjustments ReceivableAdjustment[]
  notifications   Notification[]
  chatThread      ChatThread?
  onboardingItems OnboardingItem[]
  onboardingChecks OnboardingCheck[]
  onboardingApprovals OnboardingApproval[]
  containerReturns ContainerReturn[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 1:1 문의 채팅 — 가맹점주 1명당 스레드 1개(관리자 조직과 대화). #9
model ChatThread {
  id                String   @id @default(cuid())
  merchantId        String   @unique
  merchant          User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  lastMessageAt     DateTime @default(now())
  // 자기 화면에서만 비우기(soft) — 이 시각 이전 메시지는 해당 측 화면에서 숨김
  merchantClearedAt DateTime?
  adminClearedAt    DateTime?
  createdAt         DateTime @default(now())
  messages          ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  fromAdmin Boolean // true=관리자 발신, false=가맹점주 발신
  body      String
  mediaUrl  String? // 첨부 사진·영상 URL(Vercel Blob). 없으면 텍스트 메시지
  mediaType String? // "image" | "video"
  readAt    DateTime? // 수신자가 읽은 시각
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// 인앱 알림 — 푸시 발송과 동시에 유저당 1행 적재(기기 수와 무관). 알림목록(#10)·미읽음 배지(#8)의 소스.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @default("")
  url       String? // 클릭 시 이동 경로
  type      String    @default("") // order | invoice | deposit | weekly | chat | system
  readAt    DateTime? // null = 안읽음
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// 웹 푸시 구독 — 사용자 기기별 1개 (알림 발송 대상)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  category    String // FRUIT | VEG | TOOL | TOFU
  vendorRole  String // 목적지 업자 role (조회 편의를 위한 비정규화)
  pickupTime  String? // 서부일광 타 소매업자 전용
  fulfillment String? // PICKUP | DELIVERY — 핫딜마켓 가맹점 발주 수령 방식(그 외 role은 null)

  status      String      @default("RECEIVED") // RECEIVED | DONE | CANCELLED
  confirmed   Boolean     @default(false) // 업자가 '발주 확인' 눌렀는지
  confirmedAt DateTime?
  edited      Boolean     @default(false) // 점주가 발주 후 수정했는지
  editedAt    DateTime?
  // 취소 흐름 — 점주가 '취소 요청'(cancelRequested) → 관리자 승인/임의취소 시 status=CANCELLED
  cancelRequested   Boolean   @default(false)
  cancelRequestedAt DateTime?
  cancelledAt       DateTime?
  rawText     String      @default("") // 점주가 입력한 원본(직렬화)
  aiSummary   String      @default("") // AI 사무적 요약(전체 노트)
  aiProcessed Boolean     @default(false)
  aiEngine    String      @default("none") // claude | rule | none

  // 공구(TOOL) 발주분 기준재고 차감 시각(멱등). null=미차감. 매일 8시 마감 정산/미리보기 적용이 채운다.
  // 취소 복구도 이 값이 있을 때만(=이미 차감된 발주만) base를 되돌린다.
  stockDeductedAt DateTime?

  items       OrderItem[]
  createdAt   DateTime    @default(now())

  @@index([vendorRole, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  // 점주 원본
  rawName String @default("") // 품목
  rawQty  String @default("") // 수량
  rawNote String @default("") // 부연설명(등급/다이 등 요청)

  // AI 정리본 (사무적/정갈하게)
  name String @default("") // 정리된 품목
  qty  String @default("") // 정리된 수량
  note String @default("") // 정리된 부연설명
}

// 주간발주 — 매주 토요일 12~20시 1회, 항시품목(과자류/유제품/건어물/계란) 카탈로그 체크리스트.
// 일일 발주(Order)와 완전 분리. 주(週)당 점포 1건(weekKey=그 주 토요일 KST 날짜).
model WeeklyOrder {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  weekKey String // 그 주간창 시작일(토요일, KST YYYY-MM-DD)

  // 상태: 점주가 넣으면 confirmed=false(발주 요청) → 관리자 '발주 확인' 시 true → 이후 계산서 발행.
  // 점주가 수정하면 confirmed=false로 되돌림(관리자에 '수정 요청'으로 표시).
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  edited    Boolean   @default(false)
  editedAt  DateTime?
  items     WeeklyOrderItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, weekKey]) // 주당 점포 1건(원자적 중복 방지)
  @@index([weekKey, createdAt])
}

model WeeklyOrderItem {
  id            String      @id @default(cuid())
  weeklyOrderId String
  weeklyOrder   WeeklyOrder @relation(fields: [weeklyOrderId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)

  code      String // 카탈로그 seq(예: S01)
  category  String // SNACK | DAIRY | DRIED | EGG
  name      String
  boxUnit   String @default("")
  qty       Int    @default(0) // 발주 박스 수
  unitPrice Int    @default(0) // 발주 시점 박스 공급가 스냅샷(원)
}

// 주간발주 상품 카탈로그(DB) — 관리자가 추가/삭제/수정. 정적 파일(weekly-catalog.ts)에서 시드.
model WeeklyProduct {
  code        String   @id @default(cuid())
  category    String // SNACK | DAIRY | DRIED | EGG
  name        String
  perBox      Int      @default(1) // 1박스에 몇 개(박스단위)
  supplyPrice Int      @default(0) // 박스당 공급가(원) — 가맹점 납품가/결제 단가
  tax         String   @default("") // 과세("TAXABLE")/면세("EXEMPT")/미선택("") — 상품관리에서 설정, 계산서 세액에 반영
  sortOrder   Int      @default(0)
  active       Boolean  @default(true) // false=삭제(소프트)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// 채움채(두부/콩나물) 상품 — 상품관리에서 박스입수·낱개단가·과세/면세를 관리.
// 발주는 박스 단위(1,2,3)로 들어오지만 계산서엔 낱개 단위로 환산: 계산서수량=박스수×perBox, 단가=piecePrice.
// hasBox=false(순두부처럼 박스 없이 낱개로 발주)면 발주수량 그대로, 단가만 piecePrice 적용.
// seq=채움채 사이트 product_seq(자동제출 매핑용, code 카탈로그와 이름으로 조인).
model ChaeumchaeProduct {
  id         String   @id @default(cuid())
  seq        String   @default("") // 채움채 사이트 product_seq(자동제출용)
  name       String
  hasBox     Boolean  @default(true) // false=낱개단위 발주(순두부)
  perBox     Int      @default(1) // 박스당 낱개 입수(hasBox=true일 때 환산 배수)
  piecePrice Int      @default(0) // 낱개 단가(원) — 계산서 단가
  unit       String   @default("개") // 낱개 단위 표시(개/모 등)
  tax        String   @default("") // 과세("TAXABLE")/면세("EXEMPT")/미선택("")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true) // false=취급중단(소프트삭제)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}

// 예약발주 — 관리자가 예약일자별로 상품(이름·점주공급가)을 등록하고, 점주(핫딜마켓)가 미리 수량 예약.
// 각 배치의 '픽업일 전날' 확정 수량이 그날 공구(TOOL) 발주에 읽기전용으로 자동 표시(단일출처).
// 일일 발주(Order)와 분리, 주간발주(WeeklyOrder) 구조를 따름.
model ReservationBatch {
  id          String   @id @default(cuid())
  reserveDate String   @unique // 예약(마감 기준) 일자 KST YYYY-MM-DD. 예약 마감 = 다음날 12:00
  pickupDate  String // 픽업 일자 KST YYYY-MM-DD. 공구 자동로드 = 픽업 전날
  active      Boolean  @default(true) // false = 배치 소프트삭제/숨김
  products    ReservationProduct[]
  orders      ReservationOrder[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, reserveDate])
  @@index([pickupDate])
}

// 배치별 상품 카탈로그(관리자 등록) — WeeklyProduct 대응. 상품명 + 점주공급가.
model ReservationProduct {
  id          String           @id @default(cuid())
  batchId     String
  batch       ReservationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name        String
  // 픽업일자 KST YYYY-MM-DD — 상품별로 다름(배치가 아닌 상품 단위). 공구 자동로드 = 이 픽업 전날.
  // 기존 데이터는 마이그레이션에서 배치 pickupDate로 백필. 신규는 항상 검증된 날짜 저장.
  pickupDate  String           @default("")
  supplyPrice Int              @default(0) // 점주 공급가(원) — 지금은 표시·집계용
  // 재고현황 연동 — 이 값이 있으면 InventoryItem.id를 참조(실물 재고로 진행하는 예약).
  // 빈값 = 수기 입력 상품(재고와 무관, 자유 수량). 연동이면 재고현황에서 잠기고 수량은 남은재고 캡.
  inventoryItemId String        @default("")
  sortOrder   Int              @default(0)
  active      Boolean          @default(true) // false = 소프트삭제
  // 예약 마감 시각(시분초, UTC 저장) — 신규 '단일 목록' 방식의 상품별 마감. 지나면 예약 잠김.
  // null = 레거시(배치 예약일자 20:00 규칙). Phase 1: 컬럼만 추가(아직 미사용).
  closeAt     DateTime?
  // 재고 고정 — true면 이 연동 상품은 재고(base)까지만 담기 가능(하드 캡, 예전 동작).
  // false(기본) = 초과발주 허용: 재고 넘어서 담기고 부족분은 관리자가 납품처에 추가 주문.
  stockFixed  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([batchId, active, sortOrder])
  @@index([active, closeAt])
}

// 점주×배치 1건 — 확정/수정 잠금(confirmed). 마감(예약+1 12시) 후엔 강제 잠금(판정은 앱에서).
model ReservationOrder {
  id          String                 @id @default(cuid())
  batchId     String
  batch       ReservationBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id])
  confirmed   Boolean                @default(false)
  confirmedAt DateTime?
  items       ReservationOrderItem[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([userId, batchId]) // 점주×배치 원자적 1건
  @@index([batchId])
}

// 예약 수량 행 — WeeklyOrderItem 대응(상품 스냅샷, 카탈로그와는 productId 문자열 매칭).
model ReservationOrderItem {
  id          String           @id @default(cuid())
  orderId     String
  order       ReservationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder   Int              @default(0)
  productId   String // ReservationProduct.id (매칭용, FK 아님 — 편집/삭제돼도 스냅샷 보존)
  name        String // 스냅샷
  supplyPrice Int              @default(0) // 스냅샷
  // 픽업일자 스냅샷 KST YYYY-MM-DD — 확정 시 상품에서 복사. 자동로드가 이 값(==발주일+1)으로 필터.
  pickupDate  String           @default("")
  // 재고현황 연동 스냅샷 — 값이 있으면 재고연동 상품(실시간 담기). 빈값이면 수기 상품(확정 흐름).
  // 연동 아이템은 즉시 담기(홀드)라 confirmed 무관하게 유효 → 자동로드·재고홀드 판정에 사용.
  inventoryItemId String        @default("")
  qty         Int              @default(0)
  // 픽업 시점(픽업일 오전10시)에 기준재고(InventoryItem.qty)에서 이 수량을 실제로 차감했는지.
  // null=미차감. tick 크론이 픽업 지난 연동 예약분을 1회 차감하고 이 값을 채운다(멱등).
  stockDeductedAt DateTime?
  // 품목별 발주 확정 시각. null = 미확정. Phase 4에서 공구 자동로드 게이트를
  // order.confirmed → 이 값으로 전환. Phase 1: 기존 order.confirmed 기준으로 백필(현재 동작 보존).
  confirmedAt DateTime?

  @@unique([orderId, productId]) // 주문 내 상품 1행
  @@index([pickupDate]) // 픽업 전날 공구 자동로드 필터용
  @@index([inventoryItemId]) // 재고 홀드 합계(품목별) 집계용
}

// 재고 담기원장 — 점주가 재고현황에서 '담기'한 순간의 실시간 보류(HELD).
// 남은수량 = InventoryItem.qty(기준재고) − Σ HELD(품목, 현재 발주창). 발주확정 시 기준재고 차감 + 홀드 삭제.
// 발주창 마감 시 미발주 홀드는 크론이 삭제(재고 자동 복구). 기준재고는 관리자 실물 입력이 진실(재고조사 정합).
model StockHold {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  itemId     String // InventoryItem.id (FK 아님 — 품목 삭제/교체에도 원장 보존)
  name       String // 스냅샷
  qty        Int      @default(0)
  windowDate String // 발주창 날짜 KST YYYY-MM-DD
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemId, windowDate]) // 점주×품목×발주창 1건(원자적)
  @@index([itemId, windowDate])
  @@index([windowDate])
}

// 앱 전역 메타(키-값 타임스탬프) — 예: 팝빌 계좌 최신 동기화 시각(bank_sync)
model AppMeta {
  key      String   @id
  syncedAt DateTime @default(now())
  // 값 저장용(JSON 등) — 창고 실물재고 스냅샷(wh_stock_snap) 같은 키-값 데이터.
  value    String   @default("")
}

// 재고현황 — 새롭(본사)이 작성/구글시트 동기화, 핫딜마켓 가맹점만 열람
model InventoryItem {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("") // (레거시) 상태/수량 텍스트 — 점진적으로 qty로 대체
  qty       Int      @default(0) // #6/#12 남은수량(시트 B열)
  supplyPrice Int    @default(0) // #6/#12 개당 공급가(시트 C열)
  expiry    String   @default("") // #9 유통기한 YYYY-MM-DD(빈값=없음, 시트 D열)
  // 카테고리 — 대분류(필수급)/중분류(선택). 빈값이면 그 계층 없음(예: 계란=대분류만).
  // 카테고리 목록은 '품목에 붙은 값'에서 도출 → 상품 없는 카테고리는 자동 미노출. 시트 E/F열.
  majorCat  String   @default("")
  minorCat  String   @default("")
  // 과세("TAXABLE")/면세("EXEMPT")/미선택("") — 품목마다 하드코딩. 계산서 연동 시 이 값을 불러온다.
  tax       String   @default("")
  memo      String   @default("")
  sortOrder Int      @default(0)
  // #12 시트 삭제 전파용 소프트삭제 마커(선택) — 현재는 미사용, 향후 tombstone
  deletedAt DateTime?
  updatedAt DateTime @updatedAt
}

// 입고 기록(로그) — '입고' 버튼을 누른 시점의 스냅샷. 그때 어떤 품목이 몇 개·얼마·유통기한·카테고리로
// 들어왔는지를 영구 보존한다(무제한, 자동삭제 없음). 재고현황(InventoryItem)과는 독립 —
// 나중에 조회해도 '입고 당시' 값 그대로 보인다(현재 실재고 아님). itemId는 느슨 참조(관계 아님).
model InboundLog {
  id          String   @id @default(cuid())
  name        String
  qty         Int      @default(0)
  supplyPrice Int      @default(0) // 점주 공급가(원) — 입고 당시 스냅샷
  expiry      String   @default("") // 유통기한 YYYY-MM-DD(빈값=없음)
  majorCat    String   @default("") // 카테고리(대분류) — 입고 당시 스냅샷
  minorCat    String   @default("") // 카테고리(중분류) — 입고 당시 스냅샷
  itemId      String? // 반영된 InventoryItem.id(느슨 참조 — 품목 삭제돼도 로그 보존)
  createdAt   DateTime @default(now()) // 입고 버튼 누른 시각(= 입고시간)

  @@index([createdAt])
  @@index([name])
}

// 재고 마감(계산서 기준) 수동 조정 — 관리자가 그 출고일 품목별 출고량을 수정한 '보정치'(품목명 기준).
// correction = (계산서 발행 총합 − 관리자 확정 출고량). base에 +correction 만큼 이미 반영돼 있음(양수=복구, 음수=추가차감).
// 표시 출고량 = 계산서총합 − correction. 계산서를 추가 발행/취소해도 correction은 그대로라 어긋나지 않음(멱등·정합).
model DailyStockAdjustment {
  id         String   @id @default(cuid())
  date       String // 출고일 KST YYYY-MM-DD
  itemName   String
  correction Int      @default(0) // base에 더한 보정치 = 계산서총합 − 확정출고량
  updatedAt  DateTime @updatedAt

  @@unique([date, itemName])
}

// 계산서(장끼) — 새롭이 '실제 출고 기준'으로 직접 작성해 점포에 청구.
// 발주 리스트는 참고만(경매·생물 특성상 출고가 주문과 다름). 발행 후 수정 금지(취소→재작성).
model Invoice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  date   String // 출고 기준일 (KST, YYYY-MM-DD) — 합본 발주서 날짜와 동일 단위

  // kind: DAILY(일일 발주 계산서) | WEEKLY(주간발주 입금요청서) | REFUND(환불) | SADADREAM(사다드림) — 잠금/미수 계산이 서로 오염되지 않게 분리
  // ※ SADADREAM = '사다드림'(우리 계좌가 아닌 개인/개인업체로 결제). 전체 미수와 완전 분리된 '사다드림 미수' 별도 트랙.
  //   미수를 합산하는 모든 곳에서 kind!=SADADREAM 로 제외하고, 사다드림 미수/입금확인은 별도로만 집계한다.
  kind   String @default("DAILY")

  // 사다드림 계산서 전용 — 입금받을 계좌 스냅샷(발행 시점 입력, 계산서마다 다를 수 있음). 다른 kind 는 빈 값.
  sdBank    String @default("") // 은행
  sdHolder  String @default("") // 예금주
  sdAccount String @default("") // 계좌번호

  // status: DRAFT(작성중) | ISSUED(발행·입금대기) | PAID(입금확인) | VOID(취소)
  status String @default("DRAFT")
  total  Int    @default(0) // 합계(원) — 서버가 단가×수량으로 계산
  memo   String @default("")

  // 분할 입금 요청 — 점주가 나눠 입금하겠다고 알림(관리자 수동 확인 대상)
  splitRequested   Boolean   @default(false)
  splitRequestedAt DateTime?
  splitApprovedAt  DateTime? // 관리자가 분할 입금을 승인한 시각(null=미처리 요청)
  // 수동 입금확인 — true면 자동매칭이 되돌리지 않음(관리자 판단 우선)
  manualPaid       Boolean   @default(false)

  // #11 카테고리별 확정(부분 저장) — 확정된 카테고리 CSV(예: "FRUIT,VEG"). 4종 모두 확정돼야 발행 가능.
  confirmedCats    String    @default("")

  issuedAt DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  // 발행(ISSUED) 후 관리자가 내용을 고쳐 재발송한 시각(null=수정 이력 없음).
  // issuedAt은 최초 발행 시각으로 보존(입금매칭 창 txAt>=issuedAt 이 안 깨지게).
  revisedAt DateTime?
  // 입금 기한 안내 푸시를 보낸 시각(멱등 마커 — 중복/반복 발송 방지)
  overdueRemindedAt DateTime?
  // 계산서 발행 시 이 계산서의 공구(TOOL) 품목만큼 기준재고를 차감한 시각(멱등 마커).
  // null=미차감. 계산서=실제 출고 기준 재고 차감의 유일 소스(발주 마감 자동차감 대체). 취소/수정 시 복구/재조정.
  stockDeductedAt   DateTime?
  // 실제로 차감한 재고행별 수량 스냅샷(JSON {InventoryItem.id: 차감량}). 발행 시 행별 min(청구, 그때 재고)를 기록해두고
  // 취소/수정 때 '청구량'이 아니라 '실제 차감량'을 그 행(id)에만 되돌린다 → ①초과발주로 GREATEST(0,…)에 걸려 버려진 만큼
  // 복구가 뻥튀기되는 것 방지 ②동명(name 중복) 재고행도 각 행을 정확히 복구(name 키면 합산돼 뻥튀기).
  // 빈값=옛 계산서(초과발주 이전엔 실제=청구·단일행이라 이름 기준 청구량으로 폴백해도 정확).
  stockDeductedSnap String @default("")

  items     InvoiceItem[]
  revisions InvoiceRevision[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, date])
  @@index([status, issuedAt])
  @@index([userId, kind, status])
}

// 미수 수동 조정 — 관리자가 점포 미수를 가감(입금 누락·반품·오류 정정 등). 파생 미수(receivableOf)에 합산.
// 점주는 절대 수정 불가(모든 쓰기 액션은 requireAdmin). 조정 이력은 입금관리 점포 상세에 남는다.
model ReceivableAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // +면 미수 증가, −면 미수 감소 (원)
  memo      String   @default("") // 사유
  adminId   String // 실행 관리자 id
  adminName String   @default("") // 실행 관리자 상호(사후 표시용 비정규화 스냅샷)
  createdAt DateTime @default(now())
  // 입금 매칭으로 생성된 조정이면 그 입금(Deposit.id). 매칭 해제 시 이 조정을 지워 원복.
  // unique = 한 입금당 조정 1건(멱등). 수동 미수조정은 null.
  depositId String?  @unique

  @@index([userId, createdAt])
}

// 예약발주 관리자 수정 내역 — 관리자가 점포의 예약 수량을 가감/삭제할 때마다 그 변경을 남긴다.
// (점주가 /reservations/[id] 에서 자기 예약 수정 내역을 열람. 느슨 참조 — batchId/userId 스냅샷.)
model ReservationChangeLog {
  id        String   @id @default(cuid())
  batchId   String
  userId    String
  actorName String   @default("") // 실행 관리자 상호 스냅샷
  changes   String   @default("[]") // JSON: [{name, op:changed|removed, before, after}]
  createdAt DateTime @default(now())

  @@index([batchId, userId, createdAt])
}

// 마감(일일 백업) 로그 — 관리자 '마감' 버튼으로 xlsx 백업을 내려받은 순간의 '요약'만 기록.
// xlsx 파일 자체는 저장하지 않는다(관리자가 즉시 다운로드). snapshot은 소형 JSON(점포별 미수 등, 8KB 컷).
// 데이터 유실 대비 — 언제 무엇을 백업했는지 추적 + 미수 총액 추이 확인용.
model ClosingLog {
  id               String   @id @default(cuid())
  actorId          String // 실행 관리자 id
  actorName        String   @default("") // 상호 비정규화 스냅샷
  storeCount       Int      @default(0) // 미수 집계 대상 점포 수
  receivableTotal  Int      @default(0) // 전체 미수 합계(원)
  invoiceCount     Int      @default(0) // 백업한 계산서 수
  invoiceItemCount Int      @default(0) // 백업한 출고 품목 행 수
  inventoryCount   Int      @default(0) // 백업한 재고 품목 수
  snapshot         String? // 소형 JSON 요약(점포별 미수 등)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// 계산서 수정(재발송) 내역 — 발행된 계산서를 제자리 수정(reviseInvoiceAction)할 때마다
// '그 시점(재발송 순간)에 무엇이 어떻게 바뀌었는지'를 스냅샷으로 남긴다(점주·관리자 공통 열람).
model InvoiceRevision {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  totalBefore Int      @default(0) // 수정 전 결제요청(미수) 금액
  totalAfter  Int      @default(0) // 수정 후 결제요청(미수) 금액
  changes     String   @default("[]") // 품목 변경 JSON: [{op:added|changed|removed, category, name, before?, after?}]
  createdAt   DateTime @default(now()) // 수정 재발송 시점

  @@index([invoiceId, createdAt])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category  String // FRUIT | VEG | TOOL | TOFU | WEEKLY(주간발주 합산분) — 카테고리별 섹션 표기
  sortOrder Int     @default(0)

  name      String // 품목
  qty       Float  @default(0) // 수량(소수 허용 — kg 등)
  unitPrice Int    @default(0) // 단가(원)
  amount    Int    @default(0) // 금액 = round(수량 × 단가), 서버 계산
  // 표시 단위(주간발주 합산분만: "박스"/"판"). 일반 품목은 빈값.
  unit      String @default("")
  // 재고현황 연동 스냅샷 — 값이 있으면 재고현황 상품과 연동(공구칸 드롭다운 선택). 빈값이면 수기 품목.
  // (매칭용, FK 아님 — 재고 편집/삭제돼도 계산서 스냅샷 보존.) 차감은 이름 기준이라 표시·추적용.
  inventoryItemId String @default("")
  // 과세("TAXABLE")/면세("EXEMPT")/미선택("") — 연동상품은 재고값 로드, 수기는 선택. 발행 시 미선택이면 차단.
  tax             String @default("")
  // 채움채 낱개환산 항목의 박스당 낱개입수(0=박스/일반). qty(낱개)÷unitPerBox=박스로 역환산해 이중청구 델타를 단위정합.
  unitPerBox      Int    @default(0)

  @@index([inventoryItemId])
}

// 입금 내역 — 팝빌 계좌조회로 수집한 하나 법인계좌 입금 건(자동 매칭 대상)
model Deposit {
  id           String    @id @default(cuid())
  bankTid      String    @unique // 팝빌 거래 고유 ID(중복 수집 방지)
  txAt         DateTime // 거래일시
  amount       Int // 입금액(원)
  payerName    String    @default("") // 입금자명(적요에서 추출)
  memo         String    @default("") // 적요/메모 원본
  balanceAfter Int? // 거래후 잔액
  // matchStatus: UNMATCHED | AUTO | MANUAL | IGNORED
  matchStatus  String    @default("UNMATCHED")
  matchedUserId String?
  matchedUser  User?     @relation(fields: [matchedUserId], references: [id], onDelete: SetNull)
  matchedAt    DateTime?
  // 이 입금이 어느 계산서 대금으로 소진됐는지(귀속). 소진된 입금은 다른 계산서 차액에 다시 안 셈.
  appliedInvoiceId String?
  createdAt    DateTime  @default(now())

  @@index([matchStatus, txAt])
  @@index([matchedUserId])
  @@index([appliedInvoiceId])
}

// 감사 로그 — 관리자의 파괴적 작업(회원삭제·발주 초기화·발주 취소·계산서 취소/입금취소 등) 추적.
// 삭제 계열은 snapshot에 삭제된 데이터 요약(JSON)을 남겨 사후 확인/복구 참고가 가능하게 한다.
model AuditLog {
  id         String   @id @default(cuid())
  action     String // member.delete | orders.resetAll | orders.cancelStore | invoice.void | invoice.unpay | order.unlock ...
  actorId    String // 실행한 관리자 id
  actorName  String   @default("") // 실행 관리자 상호/이름(사후 표시용, 비정규화 스냅샷)
  targetType String   @default("") // user | order | invoice | store ...
  targetId   String   @default("") // 대상 식별자
  summary    String   @default("") // 사람이 읽는 한 줄 요약
  snapshot   String? // 복구 참고용 JSON 스냅샷(삭제 등에서 사용)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

// PC용 관리자 창고 관리 — 위치(1층/냉동고/냉장고)별 평면도에 재고 품목을 박스로 배치.
// itemId는 InventoryItem을 '느슨하게' 참조(FK/relation 아님) — 품목이 삭제돼도 박스는 남고,
// label(품목명 스냅샷)로 계속 표시. 발주/재고 등 기존 테이블과 완전히 독립(추가 전용).
model WarehouseBox {
  id        String   @id @default(cuid())
  location  String // WarehouseLocation.id (느슨 참조). 초기값 FLOOR1|FREEZER|FRIDGE
  itemId    String? // InventoryItem.id 느슨 참조(관계 아님)
  label     String   @default("") // 표시 이름(품목명 스냅샷 또는 자유 입력)
  x         Int      @default(40)
  y         Int      @default(40)
  w         Int      @default(140)
  h         Int      @default(90)
  color     String   @default("") // 향후 색상 구분용(디테일 단계)
  z         Int      @default(0) // 겹침 순서
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
}

// 창고 장소(1층/냉동고/냉장고 …) — 관리자가 추가/이름변경/삭제. WarehouseBox.location이 이 id를 참조(느슨).
// 기본 3개는 마이그레이션에서 기존 키(FLOOR1/FREEZER/FRIDGE)를 id로 시드 → 기존 박스 보존.
model WarehouseLocation {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  // 평면도(입면도) 논리 크기 — 저장하면 모든 컴퓨터에서 동일하게 보인다(예전엔 localStorage라 PC마다 달랐음).
  w         Int      @default(1600)
  h         Int      @default(1000)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

// 송장(택배) 관리 — 관리자가 송장번호+택배사 등록 → 스마트택배(SweetTracker) API로 조회해
// 집하전/배송준비중/배송중/배송완료 4단계로 자동 분류. status/level은 조회 캐시.
model Shipment {
  id            String    @id @default(cuid())
  trackingNo    String // 송장번호
  courierCode   String // 스마트택배 택배사 코드(t_code)
  courierName   String // 표시용 택배사명
  itemName      String    @default("") // 품목명
  qty           Int       @default(1) // 수량
  // status: PRE_PICKUP(집하전) | READY(배송준비중) | IN_TRANSIT(배송중) | DELIVERED(배송완료) | ERROR(조회실패)
  status        String    @default("PRE_PICKUP")
  statusText    String    @default("") // 마지막 상세 상태(예: "배송출발")
  level         Int       @default(0) // 스마트택배 level(1~6)
  lastQueryMonth String    @default("") // 이 송장이 마지막으로 월 카운트에 반영된 달(YYYY-MM). 재조회는 카운트 안 함.
  lastCheckedAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================================
//  가맹 오픈 온보딩(퀘스트) — 오픈 전 필수 체크리스트
// ============================================================

// 마스터 체크리스트(관리자 편집, 전 점주 공용·단일 소스). 콘텐츠는 여기 한 곳.
model OnboardingStep {
  id        String   @id @default(cuid())
  order     Int      @default(0) // 타임라인 순서
  title     String
  body      String   @default("") // 상세(마크다운) — 관리자 편집
  images    String[] @default([]) // 첨부 이미지 URL(Supabase)
  actor     String   @default("BOTH") // 담당: MERCHANT | ADMIN | BOTH (표시용)
  required  Boolean  @default(true) // 100% 계산 포함
  active    Boolean  @default(true) // 소프트 숨김
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OnboardingItem[]

  @@index([order])
}

// 점주 × 단계 진행. 이중 확인(A): 점주 완료 + 본사 확인 둘 다면 확정.
model OnboardingItem {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId         String
  step           OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  merchantDoneAt DateTime? // 점주가 '완료' 표시한 시각
  adminDoneAt    DateTime? // 본사가 '확인'한 시각
  adminBy        String? // 확인한 관리자 상호(스냅샷)
  note           String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, stepId])
  @@index([userId])
}

// ── 튜토리얼(편집형) — 단일 공용 템플릿 ────────────────────────────
// 분류 트리(대/중/소). parentId=null 이면 대분류. 관리자가 자유 편집, 전 지점 공용.
model OnboardingNode {
  id          String   @id @default(cuid())
  parentId    String?
  parent      OnboardingNode?  @relation("OnbTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    OnboardingNode[] @relation("OnbTree")
  order       Int      @default(0)
  title       String   @default("")   // 체크박스 라벨(=분류명)
  description String   @default("")    // 설명(텍스트)
  images      String[] @default([])    // 설명 이미지 URL
  blocks      OnboardingBlock[]        // (구버전 미사용)
  approvals   OnboardingApproval[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId, order])
}

// 지점별 체크(승인제). 각 분류(노드)가 곧 체크박스. 최하위(자식 없는) 노드만 실제 체크 대상.
// 점주가 누르면 requestedAt(승인 대기), 관리자가 승인하면 approvedAt(=활성). 진행률은 approvedAt 기준.
model OnboardingApproval {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        OnboardingNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  requestedAt DateTime @default(now()) // 점주가 누른 시각(승인 대기)
  approvedAt  DateTime?                // 관리자 승인 시각(=활성/완료)
  approvedBy  String   @default("")

  @@unique([userId, nodeId])
  @@index([userId])
}

// 노드 안의 콘텐츠 블록 — 제목/텍스트/이미지/체크박스. colSpan 으로 그리드 배치(12칸).
model OnboardingBlock {
  id        String   @id @default(cuid())
  nodeId    String
  node      OnboardingNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  type      String   @default("TEXT") // HEADING | TEXT | IMAGE | CHECK
  text      String   @default("")     // HEADING/TEXT/CHECK 라벨
  imageUrl  String   @default("")     // IMAGE
  colSpan   Int      @default(12)     // 1..12 (12=한 줄 전체, 6=½, 4=⅓, 3=¼)
  checks    OnboardingCheck[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId, order])
}

// 지점별 체크 상태 — 체크박스 블록 × 점주. 진행률(체크수/전체 체크박스수)의 소스.
model OnboardingCheck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blockId   String
  block     OnboardingBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  checkedAt DateTime @default(now())
  checkedBy String   @default("") // 표시용(누가 체크)

  @@unique([userId, blockId])
  @@index([userId])
}

// ── 상품 소싱(크롤링) ─────────────────────────────────────────
// 매일 아침 자동 수집·선별. 두 트랙: LOCAL(로컬 베이커리·떡·디저트 컨택 후보) / MEALKIT(냉동·밀키트 수요 후보).
// 소스별 어댑터가 원자료를 가져오면 정규화→중복제거(key)→필터→AI선별 후 여기에 upsert.

// 로컬 업체 컨택 후보(Track A)
model SourcingLead {
  id          String   @id @default(cuid())
  key         String   @unique // 정규화 상호(+지역) — 소스 간 중복 병합 기준
  source      String   @default("") // naver-local | firecrawl | manual ...
  sourceRef   String   @default("") // 외부 id/url
  name        String
  region      String   @default("") // 지역(성수/연남 등)
  category    String   @default("") // 베이커리 | 디저트 | 떡
  storeCount  Int? // 호점 수(모르면 null)
  isFranchise Boolean  @default(false)
  reviewCount Int?
  trendScore  Float    @default(0) // 랭킹용 종합 점수
  instagram   String   @default("")
  phone       String   @default("")
  url         String   @default("")
  reason      String   @default("") // AI 추천 이유 한 줄
  mentions    Int      @default(1) // 서로 다른 매체/소스가 언급한 수(근거 강도)
  note        String   @default("") // 관리자 메모
  status      String   @default("NEW") // NEW | CONTACTED | REJECTED | DEAL | IGNORED
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, trendScore])
  @@index([lastSeenAt])
}

// 밀키트/냉동 수요 후보(Track B)
model SourcingProduct {
  id             String   @id @default(cuid())
  key            String   @unique // 정규화 제품명(+브랜드)
  source         String   @default("")
  sourceRef      String   @default("")
  name           String
  brand          String   @default("")
  category       String   @default("")
  price          Int?
  reviewCount    Int?
  prevReviewCount Int? // 리뷰속도 계산용(직전 스냅샷)
  reviewVelocity Float    @default(0) // 최근 리뷰 증가속도(수요 프록시)
  demandScore    Float    @default(0)
  isBigBrand     Boolean  @default(false)
  marginEst      Int? // 예상 마진(있으면)
  url            String   @default("")
  imageUrl       String   @default("")
  reason         String   @default("")
  mentions       Int      @default(1)
  note           String   @default("")
  status         String   @default("NEW") // NEW | PICKED | IGNORED
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, demandScore])
  @@index([lastSeenAt])
}

// 수집 실행 로그(관측용)
model SourcingRun {
  id         String   @id @default(cuid())
  track      String // LOCAL | MEALKIT
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  found      Int      @default(0) // 수집 원자료 수
  kept       Int      @default(0) // 필터 후 저장 수
  ok         Boolean  @default(true)
  error      String   @default("")
  detail     String   @default("") // 소스별 요약(json)

  @@index([startedAt])
}

// ── 사내 메신저 ─────────────────────────────────────────────────────────────
// 1차 로그인(공용 새롭 관리자 saerop)으로 관리자 화면 진입 후, 메신저는 '2차 로그인'으로 개인 식별.
// 멤버=개인 신원(이름+PIN). 채널=주제별 방(전 멤버 공용). 외부(가맹점)엔 절대 노출 안 됨.
model MessengerMember {
  id        String   @id @default(cuid())
  name      String
  pinHash   String // bcrypt 해시(개인 PIN)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  messages MessengerMessage[]
  reads    MessengerRead[]

  @@index([active, sortOrder])
}

model MessengerChannelGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model MessengerChannel {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  favorite  Boolean  @default(false) // 즐겨찾기(팀 공용) — 홈 바로가기·사이드바 상단
  groupId   String? // 채널 그룹(단 나누기, 관계없는 String — 그룹 삭제 시 null 처리)
  createdAt DateTime @default(now())

  messages MessengerMessage[]
  reads    MessengerRead[]

  @@index([archived, sortOrder])
}

model MessengerMessage {
  id        String           @id @default(cuid())
  channelId String
  channel   MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  memberId  String
  member    MessengerMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  body      String
  mediaUrl  String? // 첨부 사진·영상(Vercel Blob) — 단일/대표(하위호환)
  mediaType String? // "image" | "video"
  mediaUrls String[] @default([]) // 사진 묶어보내기 — 여러 장(2장 이상이면 그리드)
  fileUrl   String? // 일반 파일 첨부(문서 등, 최대 100MB)
  fileName  String? // 파일 원본 이름(다운로드 표시용)
  // 답장(대댓글) — 원본 메시지 미리보기를 비정규화 저장(원본 삭제·변경에도 견고).
  replyToId   String?
  replyToName String?
  replyToBody String?
  noticeAt    DateTime? // 공지 등록 시각(null=일반 메시지)
  createdAt   DateTime  @default(now())

  @@index([channelId, createdAt])
  @@index([channelId, noticeAt])
}

// @멘션 — 메시지에서 언급된 팀원. 홈 화면 '멘션 토픽'용(누르면 해당 채팅으로 이동).
model MessengerMention {
  id                String   @id @default(cuid())
  channelId         String
  messageId         String
  mentionedMemberId String // 언급된 멤버 id
  byMemberId        String // 언급한(보낸) 멤버 id
  preview           String // 메시지 미리보기(비정규화)
  readAt            DateTime? // 홈에서 확인(클릭)한 시각 — null이면 '받은 멘션'에 노출
  createdAt         DateTime @default(now())

  @@index([mentionedMemberId, createdAt])
  @@index([messageId])
}

// 할 일 개인별 완료 — 다중/전체 배정 시 멤버 각자 자기 완료를 체크(누가 했는지 취합).
// MessengerTask.done(단일 플래그)와 별개: 이 테이블 유무가 '그 멤버의 완료' 진실.
model MessengerTaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  memberId    String
  completedAt DateTime @default(now())

  @@unique([taskId, memberId])
  @@index([taskId])
}

// 반복(기본) 할일 — 요청(배정) 할일과 별개. 멤버 각자에게 정해진 매일/특정요일 체크리스트.
// 소유자(memberId)만 체크, 추가·수정·삭제는 누구나. 완료는 날짜별(MessengerRecurringCompletion)로
// 기록 → 자정(KST)마다 자동 리셋(오늘 날짜에 완료행 없으면 미완료), 과거 기록은 보존.
model MessengerRecurringTask {
  id          String   @id @default(cuid())
  memberId    String // 이 반복할일의 주인(체크는 이 멤버만)
  title       String
  days        Int      @default(127) // 요일 비트마스크(bit i = 요일 i, 0=일…6=토). 127=매일
  sortOrder   Int      @default(0)
  createdById String // 만든 사람(참고)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId, sortOrder])
}

// 반복 할일 '그 날' 완료 마커 — 존재 = 그 KST 날짜에 체크됨. 없으면 미완료(자정 자동 리셋).
model MessengerRecurringCompletion {
  id        String   @id @default(cuid())
  taskId    String // MessengerRecurringTask.id (느슨 참조)
  date      String // 체크한 KST 날짜 YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([taskId, date])
  @@index([taskId])
}

// 메신저 웹푸시 구독 — 멤버 단위(핫딜오더 User가 아님, 전원 공용 saerop로 1차 로그인). endpoint=기기.
model MessengerPushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([memberId])
}

// 메시지 공감(체크) — 카톡 공감처럼 멤버가 메시지에 ✓ 반응(멤버당 1개, 누가 눌렀는지 표시).
model MessengerReaction {
  id        String   @id @default(cuid())
  messageId String
  memberId  String
  createdAt DateTime @default(now())

  @@unique([messageId, memberId])
  @@index([messageId])
}

// 멤버×채널 마지막 읽음 시각 — 안 읽은 메시지 배지용.
model MessengerRead {
  id         String           @id @default(cuid())
  memberId   String
  member     MessengerMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channelId  String
  channel    MessengerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime         @default(now())

  @@unique([memberId, channelId])
}

// 사내 메신저 할일(팀 전체 공용, 모두에게 노출). 보낸사람=createdById(시킨 사람), 받는사람=assigneeId(팀원) 또는 toAll(팀 전체).
// createdById/assigneeId 는 MessengerMember.id(관계 없이 문자열 — 삭제 내구성).
model MessengerTask {
  id          String    @id @default(cuid())
  title       String
  detail      String? // 상세 설명(제목 클릭 시 팝업)
  done        Boolean   @default(false)
  assigneeId  String? // (레거시) 단일 받는 사람 — 하위호환. 신규는 assigneeIds 사용
  assigneeIds String[]  @default([]) // 받는 사람(다중) 멤버 id 목록(toAll=false일 때)
  toAll       Boolean   @default(false) // 받는 사람 = 팀원 전체
  dueDate     DateTime? // 마감일(KST 자정 기준 저장, 선택)
  createdById String // 보낸 사람(시킨 사람) 멤버 id
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([done, createdAt])
  @@index([dueDate])
}

// 사내 메신저 팀 캘린더 일정(팀 전체 공용). date = 해당 일자(KST 자정 기준 저장).
model MessengerEvent {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  memo        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([date])
}

// 회의록 — 회의 사진(A4 세로) 묶음을 날짜별로 보관. 업로더만 삭제 가능.
model MessengerMinutes {
  id          String   @id @default(cuid())
  meetingDate DateTime // 회의 날짜(KST 자정)
  agenda      String? // (폐지·미사용) 안건 목차 — 코드에서 안 읽고 안 씀. 데이터는 마이그레이션으로 NULL 처리. 컬럼은 드롭 안 함(라이브 구코드 읽기 대비)

  imageUrls   String[] // A4 세로 이미지들(순서 보존)
  memberId    String // 업로더 멤버 id
  createdAt   DateTime @default(now())

  reads MessengerMinutesRead[]

  @@index([meetingDate])
}

// 회의록 읽음 표시 — 누가 읽었는지(멤버×회의록 1건).
model MessengerMinutesRead {
  id        String           @id @default(cuid())
  minutesId String
  minutes   MessengerMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  memberId  String
  readAt    DateTime         @default(now())

  @@unique([minutesId, memberId])
  @@index([minutesId])
}

// ── 반납 용기 관리(아이스박스·우유 콘티 등) ──────────────────────────────
// 회수 대상 용기 종류. 나간 수량은 별도로 저장하지 않고, 계산서 공구란(InvoiceItem category=TOOL)에서
// 이름이 matchKey(정규화 후 부분일치)와 매칭되고 date >= startDate 인 것들을 실시간 집계한다.
// 회수는 ContainerReturn 에만 기록 → 미회수 = 나감 − 회수.
model ReturnableContainer {
  id        String            @id @default(cuid())
  name      String // 표시 이름(예: "아이스박스", "우유 콘티")
  matchKey  String // 매칭 키워드 — 계산서 품목명과 비교(정규화: 공백제거·소문자 후 contains)
  startDate String // 집계 시작일 YYYY-MM-DD — 이 날짜(포함) 이후 발행 계산서만 '나감'으로 집계
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  returns   ContainerReturn[]

  @@index([active, sortOrder])
}

// 용기 회수 이력(수기). 지점(userId)에서 특정 용기를 회수한 건. 미회수는 이 합을 나감에서 뺀 값.
model ContainerReturn {
  id          String              @id @default(cuid())
  containerId String
  container   ReturnableContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  qty         Int // 회수 수량(양수)
  memo        String              @default("")
  adminId     String // 처리 관리자 id
  adminName   String              @default("") // 처리 관리자 상호(사후 표시용 스냅샷)
  returnedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())

  @@index([containerId, userId])
  @@index([userId])
}

// 재고현황 품목 값 변경 기록(감사) — 수기 편집(에디터 자동저장·추가·수정·삭제·붙여넣기·분류)으로
// 품목의 값이 바뀔 때마다 필드별 before→after 를 남긴다. 오타/의도치 않은 변경 추적용.
// (자동 차감=계산서/담기, 입고=InboundLog 는 별도 추적이라 여기서 제외.)
model InventoryChangeLog {
  id        String   @id @default(cuid())
  itemId    String // InventoryItem.id (FK 아님 — 품목 삭제돼도 로그 보존)
  itemName  String // 변경 시점 품목명 스냅샷
  field     String // name|qty|supplyPrice|expiry|majorCat|minorCat|tax|memo | "(추가)" | "(삭제)"
  kind      String   @default("update") // create | update | delete
  before    String   @default("")
  after     String   @default("")
  actorId   String   @default("")
  actorName String   @default("") // 처리자 상호(스냅샷)
  source    String   @default("") // 재고 편집 | 품목 추가 | 품목 삭제 | 붙여넣기 | AI 분류 등
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
}
